package ui

import (
	"fmt"

	"twikko/internal/schema"
)

templ Page(data PageData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ data.Title }</title>
			<script src={ templ.SafeURL(data.AssetBase + "htmx.min.js") }></script>
			<script src={ templ.SafeURL(data.AssetBase + "app.js") } defer></script>
			<script src={ templ.SafeURL(data.AssetBase + "table.js") } defer></script>
			<link rel="stylesheet" href={ templ.SafeURL(data.AssetBase + "styles.css") }/>
		</head>
		<body hx-sync="this:queue all">
			<main class={ templ.Classes("mx-auto px-4 py-8 pb-32", templ.KV("max-w-5xl", data.Mode != "table")) }>
				<header class="mb-6">
					<h1 class="text-2xl font-semibold tracking-tight">{ data.Title }</h1>
					if data.Description != "" {
						<p class="mt-1 whitespace-pre-line text-sm text-muted-foreground">{ data.Description }</p>
					}
				</header>
				@Entities(data)
				<footer class="mt-12 text-center text-xs text-muted-foreground/60 select-none">Twikko, 2026</footer>
			</main>
			@SaveBar(data, false)
		</body>
	</html>
}

templ Entities(data PageData) {
	<div id="entities" data-view-mode={ data.Mode } class="space-y-5">
		if data.Mode == "table" && len(data.Columns) > 0 {
			<div class="max-h-[70vh] overflow-auto">
				<table id="data-table" data-sort-url={ fmt.Sprintf("/s/%s/table/sort", data.Token) } data-highlights-url={ fmt.Sprintf("/s/%s/table/highlights", data.Token) } data-relative-highlights={ fmt.Sprint(data.RelativeHighlights) } class="data-table table-fixed border-collapse text-left" style={ templ.SafeCSS(fmt.Sprintf("width:%dpx", len(data.Columns)*200+152)) }>
					<colgroup>
						<col data-column-key="number" style="width:56px"/>
						for index := range data.Columns {
							<col data-column-key={ fmt.Sprint(index) } style="width:200px"/>
						}
						<col data-column-key="actions" style="width:96px"/>
					</colgroup>
					<thead>
						<tr>
							<th scope="col" data-column-key="number" aria-sort="ascending" class="sticky top-0 z-10 border border-border bg-background px-2 py-2 text-sm font-medium text-muted-foreground">
								<button type="button" data-column-sort="number" aria-label="Sort by row number" class="table-sort-button"><span>#</span><span data-sort-indicator aria-hidden="true">@Icon(data, "chevron-right")</span></button>
							</th>
							for index, column := range data.Columns {
								<th scope="col" data-column-key={ fmt.Sprint(index) } aria-sort="none" class="sticky top-0 z-10 border border-border bg-background px-2 py-2 text-sm font-medium">
									<div class="flex min-w-0 items-center gap-1 pr-2">
										<button type="button" data-column-drag={ fmt.Sprint(index) } aria-label={ "Move " + columnHeading(column) } title="Drag to move. Space then arrow keys to move with the keyboard." class="table-column-drag">@Icon(data, "dots")</button>
										if column.Sortable {
											<button type="button" data-column-sort={ fmt.Sprint(index) } aria-label={ "Sort by " + columnHeading(column) } class="table-sort-button">
												<span class={ templ.Classes("truncate", templ.KV("sr-only", !column.ShowLabel)) }>{ columnHeading(column) }</span><span data-sort-indicator aria-hidden="true">@Icon(data, "chevron-right")</span>
											</button>
										} else {
											<span class={ templ.Classes("block truncate", templ.KV("sr-only", !column.ShowLabel)) }>{ columnHeading(column) }</span>
										}
									</div>
									<button type="button" role="separator" aria-orientation="vertical" aria-label={ "Resize " + columnHeading(column) } aria-controls="data-table" aria-valuemin="96" aria-valuenow="200" data-column-resize={ fmt.Sprint(index) } title="Drag to resize. Double-click or press Enter to fit content." class="absolute inset-y-0 right-0 w-2 cursor-col-resize touch-none select-none hover:bg-accent focus-visible:bg-accent focus-visible:outline-none"></button>
								</th>
							}
							<th scope="col" data-column-key="actions" class="sticky top-0 z-10 border border-border bg-background px-3 py-2 text-sm font-medium">
								Actions
								<button type="button" role="separator" aria-orientation="vertical" aria-label="Resize Actions" aria-controls="data-table" aria-valuemin="96" aria-valuenow="96" data-column-resize="actions" title="Drag to resize. Double-click or press Enter to fit content." class="absolute inset-y-0 right-0 w-2 cursor-col-resize touch-none select-none hover:bg-accent focus-visible:bg-accent focus-visible:outline-none"></button>
							</th>
						</tr>
					</thead>
					<tbody>
						for _, entity := range data.Entities {
							@TableRow(data, entity)
						}
					</tbody>
				</table>
				<p data-table-announcement class="sr-only" role="status" aria-live="polite"></p>
			</div>
		} else {
			for _, entity := range data.Entities {
				@EntityCard(data, entity)
			}
		}
	</div>
}

templ TableRow(data PageData, entity EntityView) {
	<tr id={ fmt.Sprintf("entity-%d", entity.Index) } data-entity-index={ fmt.Sprint(entity.Index) } class={ entity.HighlightClass }>
		<td data-column-key="number" class="border border-border px-2 py-2 align-top text-right text-sm text-muted-foreground tabular-nums">{ fmt.Sprint(entity.Index + 1) }</td>
		for index, widget := range entity.Cells {
			<td data-column-key={ fmt.Sprint(index) } class="border border-border p-0 align-top">
				if widget.Type == schema.WidgetTextarea || widget.Type == schema.WidgetMultiSelect {
					<details open?={ widget.Field.Error!="" }>
						@CellSummary(entity.Index, *widget.Field, false)
						@Widget(data, entity, widget, false)
					</details>
				} else {
					@Widget(data, entity, widget, false)
				}
			</td>
		}
		<td data-column-key="actions" class="border border-border p-2 align-top text-sm"><button hx-post={ templ.SafeURL(fmt.Sprintf("/s/%s/entities/%d/reset", data.Token, entity.Index)) } hx-target={ fmt.Sprintf("#entity-%d", entity.Index) } hx-swap="outerHTML settle:0ms">Reset</button></td>
	</tr>
}

templ EntityCard(data PageData, entity EntityView) {
	<section id={ fmt.Sprintf("entity-%d", entity.Index) } class="rounded-lg border bg-card text-card-foreground shadow-xs [content-visibility:auto] [contain-intrinsic-size:auto_600px]">
		<header class={ templ.Classes("flex items-center justify-between gap-4 px-5 py-4", templ.KV("border-b", !entity.Collapsed)) }>
			<div class="flex min-w-0 items-center gap-3">
				@CollapseToggle(data, entity)
				if entity.HasHeader {
					<div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-2">
						for _, widget := range entity.Widgets {
							@Widget(data, entity, widget, true)
						}
					</div>
				} else {
					<h2 class="truncate text-sm font-medium">{ entity.Title }</h2>
				}
				@EntityBadges(entity, false)
			</div>
			@CardMenu(data, entity)
		</header>
		if !entity.Collapsed {
			if entity.HasBody {
				<div class="flex flex-col gap-5 p-5">
					for _, row := range entity.Rows {
						<div
							class={ row.Class }
							if row.Style != "" {
								style={ templ.SafeCSS(row.Style) }
							}
						>
							for _, widget := range row.Widgets {
								@Widget(data, entity, widget, false)
							}
						</div>
					}
				</div>
			} else {
				<div class="grid gap-5 p-5 md:grid-cols-2">
					for _, widget := range entity.Grid {
						@Widget(data, entity, widget, false)
					}
				</div>
			}
		}
	</section>
}

// EntityBadges marks a collapsed card that holds errors or changes. Edits can
// happen in a header control while the card is collapsed, so an edit refreshes
// it out of band.
templ EntityBadges(entity EntityView, oob bool) {
	<div id={ fmt.Sprintf("entity-badges-%d", entity.Index) } { oobAttrs(oob)... } class="flex shrink-0 items-center gap-3 empty:hidden">
		if entity.Collapsed && entity.HasErrors {
			<span class="shrink-0 rounded-full bg-destructive/10 px-2 py-0.5 text-xs font-medium text-destructive">Has errors</span>
		}
		if entity.Collapsed && entity.ChangedCount > 0 {
			<span class="shrink-0 rounded-full bg-changed/15 px-2 py-0.5 text-xs font-medium text-changed-foreground">{ fmt.Sprintf("%d changed", entity.ChangedCount) }</span>
		}
	</div>
}

// Widget draws one header or body widget: a control, or a display slot.
templ Widget(data PageData, entity EntityView, widget WidgetView, header bool) {
	if widget.IsLine() {
		@Line(widget)
	} else if widget.Field != nil {
		@Control(data, entity, widget, header)
	} else {
		@DisplaySlot(data, widget, header, false)
	}
}

// Line is a separator. It has no content, so a vline adds nothing to the height
// of its row.
templ Line(widget WidgetView) {
	<div role="separator" aria-orientation={ widget.Orientation() } class={ widget.Class }></div>
}

// DisplaySlot is a read-only widget with an optional label. In the header the
// label is a muted prefix and an empty slot collapses. In the body the label is
// a caption and an empty slot keeps its place. With oob it renders as an
// out-of-band htmx swap, so editing a field refreshes the widgets that show it.
// Controls are never swapped, which keeps the focus of the one being typed in.
templ DisplaySlot(data PageData, widget WidgetView, header bool, oob bool) {
	<div id={ widget.ID } { oobAttrs(oob)... } class={ displaySlotClass(header) }>
		if widget.HasValue {
			if widget.ShowLabel && widget.Label != "" {
				if header {
					<span class="shrink-0 text-xs text-muted-foreground">{ widget.Label }</span>
				} else {
					<span class="mb-1.5 block text-sm font-medium">{ widget.Label }</span>
				}
			}
			@DisplayWidget(data, widget)
		}
	</div>
}

templ DisplayWidget(data PageData, widget WidgetView) {
	if widget.Type == schema.WidgetIcon {
		<span class={ widget.Class } role="img" aria-label={ widget.Text } title={ widget.Text }>
			@Icon(data, widget.Icon)
		</span>
	} else if widget.Type == schema.WidgetTag {
		<span class={ widget.Class }>{ widget.Text }</span>
	} else {
		<span class={ widget.Class } title={ widget.Text }>{ widget.Text }</span>
	}
}

// DisplaySlots renders every display slot of a card out of band, header and body.
templ DisplaySlots(data PageData, entity EntityView) {
	if data.Mode == "table" {
		for _, widget := range entity.Cells {
			if widget.Field == nil && !widget.IsLine() {
				@DisplaySlot(data, widget, false, true)
			}
		}
	} else {
		for _, widget := range entity.Widgets {
			if widget.Field == nil && !widget.IsLine() {
				@DisplaySlot(data, widget, true, true)
			}
		}
		for _, row := range entity.Rows {
			for _, widget := range row.Widgets {
				if widget.Field == nil && !widget.IsLine() {
					@DisplaySlot(data, widget, false, true)
				}
			}
		}
	}
}

// CollapseToggle shows an open eye while the card is expanded and a crossed
// eye while it is collapsed. Pressing it sends the opposite state.
templ CollapseToggle(data PageData, entity EntityView) {
	<button
		type="button"
		class="flex size-8 shrink-0 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground"
		aria-expanded={ fmt.Sprintf("%t", !entity.Collapsed) }
		aria-label={ collapseLabel(entity) }
		title={ collapseLabel(entity) }
		hx-post={ templ.SafeURL(fmt.Sprintf("/s/%s/entities/%d/collapsed", data.Token, entity.Index)) }
		hx-vals={ fmt.Sprintf(`{"collapsed": "%t"}`, !entity.Collapsed) }
		hx-target={ fmt.Sprintf("#entity-%d", entity.Index) }
		hx-swap="outerHTML settle:0ms"
	>
		if entity.Collapsed {
			@Icon(data, "eye-off")
		} else {
			@Icon(data, "eye")
		}
	</button>
}

templ CardMenu(data PageData, entity EntityView) {
	<details class="relative" data-menu>
		<summary
			class="flex size-8 cursor-pointer list-none items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground [&::-webkit-details-marker]:hidden"
			aria-label={ fmt.Sprintf("Actions for %s", entity.Title) }
			aria-haspopup="menu"
		>
			@Icon(data, "dots")
		</summary>
		<div class="absolute right-0 z-10 mt-1 w-40 rounded-md border bg-popover p-1 text-popover-foreground shadow-md" role="menu">
			<button
				type="button"
				role="menuitem"
				class="block w-full rounded-sm px-2 py-1.5 text-left text-sm hover:bg-accent hover:text-accent-foreground"
				hx-post={ templ.SafeURL(fmt.Sprintf("/s/%s/entities/%d/reset", data.Token, entity.Index)) }
				hx-target={ fmt.Sprintf("#entity-%d", entity.Index) }
				hx-swap="outerHTML settle:0ms"
			>Reset</button>
		</div>
	</details>
}

// Control draws the edit control of a field. A control in the header has no
// visible label, which is its tooltip and accessible name instead, and shows
// only errors under it.
templ Control(data PageData, entity EntityView, widget WidgetView, header bool) {
	<div data-field-control class={ controlWrapperClass(header, widget.Field.Changed) }>
		if (widget.Type != schema.WidgetToggle || (!widget.Field.Field.Required && data.NewFormat)) && (!header || data.NewFormat) {
			<label class={ templ.Classes("mb-1.5 block text-sm font-medium", templ.KV("sr-only", !widget.ShowLabel)) } for={ fieldID(entity.Index, widget.Field.Field.Name) }>
				if widget.Type==schema.WidgetToggle && widget.Label!="" {
					{ widget.Label }
				} else {
					{ widget.Field.Field.Label }
				}
				if widget.Field.Field.Required {
					<span class="text-destructive">*</span>
				}
			</label>
		}
		switch widget.Type {
			case schema.WidgetTextarea:
				<textarea
					id={ fieldID(entity.Index, widget.Field.Field.Name) }
					name="value"
					class={ textareaClass(header) }
					disabled?={ widget.Field.Field.Readonly }
					{ controlAttrs(data, entity, widget, header, "input changed, change")... }
				>{ String(widget.Field.Value) }</textarea>
			case schema.WidgetSelect:
				<select
					id={ fieldID(entity.Index, widget.Field.Field.Name) }
					name="value"
					class={ inputClass(header) }
					disabled?={ widget.Field.Field.Readonly }
					{ controlAttrs(data, entity, widget, header, "change")... }
				>
					if !validChoice(widget.Field.Field,String(widget.Field.Value)) && (String(widget.Field.Value)!="" || widget.Field.Field.Required) {
						<option value={ String(widget.Field.Value) } selected disabled>{ selectPlaceholder(widget.Field.Value) }</option>
					}
					if !widget.Field.Field.Required {
						<option value="" selected?={ String(widget.Field.Value)=="" }>Select...</option>
					}
					for _, option := range choices(widget.Field.Field) {
						<option value={ option } selected?={ String(widget.Field.Value) == option }>{ option }</option>
					}
				</select>
			case schema.WidgetMultiSelect:
				<div role="group" aria-label={ widget.Field.Field.Label } class="flex flex-wrap gap-x-4 gap-y-2 rounded-md border border-input p-3" id={ fmt.Sprintf("group-%d-%s", entity.Index, domKey(widget.Field.Field.Name)) }>
					for _, option := range widget.Field.Field.Options {
						<label class="inline-flex items-center gap-2 text-sm">
							<input
								type="checkbox"
								class="size-4 accent-primary"
								name="value"
								value={ option }
								checked?={ Contains(widget.Field.Value, option) }
								disabled?={ widget.Field.Field.Readonly }
								hx-include={ fmt.Sprintf("#group-%d-%s", entity.Index, domKey(widget.Field.Field.Name)) }
								{ controlAttrs(data, entity, widget, false, "change")... }
							/>
							{ option }
						</label>
					}
				</div>
			case schema.WidgetToggle:
				if !widget.Field.Field.Required && data.NewFormat {
					<select id={ fieldID(entity.Index, widget.Field.Field.Name) } name="value" class={ inputClass(header) } disabled?={ widget.Field.Field.Readonly } { controlAttrs(data, entity, widget, header, "change")... }>
						if value:=String(widget.Field.Value);value!="" && value!="true" && value!="false" {
							<option value={ value } selected disabled>{ selectPlaceholder(widget.Field.Value) }</option>
						}
						<option value="" selected?={ String(widget.Field.Value)=="" }>Unset</option><option value="true" selected?={ String(widget.Field.Value) == "true" }>True</option><option value="false" selected?={ String(widget.Field.Value) == "false" }>False</option>
					</select>
				} else {
					<label class={ switchLabelClass }>
						<input
							id={ fieldID(entity.Index, widget.Field.Field.Name) }
							type="checkbox"
							role="switch"
							class="peer sr-only"
							name="value"
							checked?={ String(widget.Field.Value) == "true" }
							disabled?={ widget.Field.Field.Readonly }
							aria-label={ widget.Field.Field.Label }
							{ controlAttrs(data, entity, widget, false, "change")... }
						/>
						<span class={ switchTrackClass } aria-hidden="true"></span>
						if widget.ShowLabel && widget.Label != "" {
							<span class="text-sm">{ widget.Label }</span>
						}
					</label>
				}
			case schema.WidgetDate, schema.WidgetTime, schema.WidgetDateTime:
				@Picker(data, entity, widget, header)
			default:
				<input
					id={ fieldID(entity.Index, widget.Field.Field.Name) }
					type={ inputType(widget.Type) }
					if widget.Type == schema.WidgetNumber {
						inputmode="decimal"
					}
					name="value"
					value={ String(widget.Field.Value) }
					class={ inputClass(header) }
					disabled?={ widget.Field.Field.Readonly }
					{ controlAttrs(data, entity, widget, header, "input changed, change")... }
				/>
		}
		@FieldStatus(entity.Index, *widget.Field)
	</div>
}

// Picker is the date, time and date-time control: a masked text input, so the
// value can be typed, with a button inside it that opens a calendar popover.
// The browser draws a native picker outside the page, where no CSS reaches, so
// static/app.js builds the popover. A hidden input holds the value that the
// form posts, in the format the native input used. The script writes it and
// fires change on it.
templ Picker(data PageData, entity EntityView, widget WidgetView, header bool) {
	<div data-picker={ string(widget.Type) } data-required?={ widget.Field.Field.Required } data-icons={ data.AssetBase + "icons/" } class="relative">
		<input
			type="hidden"
			name="value"
			value={ String(widget.Field.Value) }
			{ controlAttrs(data, entity, widget, false, "change")... }
		/>
		<input
			id={ fieldID(entity.Index, widget.Field.Field.Name) }
			type="text"
			inputmode="numeric"
			autocomplete="off"
			data-picker-input
			value={ pickerText(widget) }
			placeholder={ pickerPlaceholder(widget.Type) }
			class={ pickerInputClass(widget.Type, header) }
			disabled?={ widget.Field.Field.Readonly }
			if true {
				aria-label={ widget.Field.Field.Label }
				aria-describedby={ fmt.Sprintf("status-%d-%s", entity.Index, domKey(widget.Field.Field.Name)) }
				title={ widget.Field.Field.Label }
			}
		/>
		<button
			type="button"
			class="absolute inset-y-0 left-0 flex w-9 items-center justify-center rounded-l-md text-muted-foreground hover:text-foreground disabled:pointer-events-none"
			disabled?={ widget.Field.Field.Readonly }
			aria-label={ pickerButtonLabel(widget.Type) }
			aria-haspopup="dialog"
			aria-expanded="false"
			data-picker-trigger
		>
			@Icon(data, pickerIcon(widget.Type))
		</button>
	</div>
}

templ FieldStatus(index int, field FieldView) {
	<div id={ fmt.Sprintf("status-%d-%s", index, domKey(field.Field.Name)) } data-field-status data-invalid={ fmt.Sprint(field.Error != "") } data-changed={ fmt.Sprint(field.Changed) } class={ statusClass(field) }>
		if field.Error != "" {
			<span class="text-destructive">{ field.Error }</span>
			if raw:=invalidValueText(field);raw!="" {
				<span class="ml-2 whitespace-pre-wrap break-words text-muted-foreground">{ raw }</span>
			}
		} else if field.Changed && !field.Compact {
			<span class="text-changed-foreground">Changed</span>
		}
	</div>
}

// SaveBar is the sticky action bar. With oob it renders as an out-of-band
// htmx swap that replaces the bar already on the page.
templ SaveStatus(data PageData, oob bool) {
	<p id="save-status" { oobAttrs(oob)... } class="text-sm text-muted-foreground" role="status">
		{ fmt.Sprintf("%d changed field(s)",data.Changes) }
		if data.HasErrors {
			<span class="ml-2 text-destructive">Fix validation errors before saving.</span>
		}
	</p>
}

templ SaveBar(data PageData, oob bool) {
	if oob {
		@SaveStatus(data, true)
	} else {
		<div id="save-bar" class="fixed inset-x-0 bottom-0 border-t bg-background/90 px-4 py-3 backdrop-blur">
			<div class="mx-auto flex max-w-5xl items-center justify-between gap-4">
				@SaveStatus(data, false)
				<div class="flex gap-3">
					<button class={ outlineButtonClass } hx-post={ templ.SafeURL(fmt.Sprintf("/s/%s/cancel", data.Token)) } hx-target="body" hx-swap="innerHTML settle:0ms">Cancel</button>
					<button class={ primaryButtonClass } hx-post={ templ.SafeURL(fmt.Sprintf("/s/%s/save", data.Token)) } hx-target="body" hx-swap="innerHTML settle:0ms">Save</button>
				</div>
			</div>
		</div>
	}
}

// Icon draws a vendored Tabler icon (static/icons/<name>.svg) in the current
// text colour.
templ Icon(data PageData, name string) {
	<span class="icon" style={ templ.SafeCSS(fmt.Sprintf("--icon: url(%sicons/%s.svg)", data.AssetBase, name)) } aria-hidden="true"></span>
}

templ DonePage(saved bool) {
	<!DOCTYPE html>
	<html lang="en">
		<body>
			<main>
				if saved {
					<h1>Saved</h1>
					<p>The result file was written. You can close this tab.</p>
				} else {
					<h1>Cancelled</h1>
					<p>No changes were saved. You can close this tab.</p>
				}
			</main>
		</body>
	</html>
}

templ CellSummary(index int, field FieldView, oob bool) {
	<summary id={ fmt.Sprintf("summary-%d-%s", index, domKey(field.Field.Name)) } { oobAttrs(oob)... } class="cursor-pointer max-w-full truncate px-2 py-2 text-sm">{ editorSummary(field) }</summary>
}
