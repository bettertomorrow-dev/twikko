#!/usr/bin/env bash
# Run the current source of multieditor from any directory.
# Symlink this file onto PATH as `multieditor`. Build output goes to stderr so
# stdout carries only multieditor's own output (the URL, the final status).
set -euo pipefail

self="$(realpath "${BASH_SOURCE[0]}")"
repo="$(dirname "$(dirname "$self")")"

{
  make -s -C "$repo" generate
  go build -C "$repo" -o "$repo/bin/multieditor" .
} >&2

exec "$repo/bin/multieditor" "$@"
